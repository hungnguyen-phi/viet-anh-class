# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ file MẪU: không chứa giá trị thật, và người clone repo cần nó để biết phải set biến gì.
# Trước đây `.env*` bắt luôn nó nên .env.example chưa bao giờ vào repo.
!.env.example

# vercel
.vercel

# supabase (local CLI state — không đưa lên repo)
supabase/.branches/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# đo hiệu năng (scripts/measure-query-waterfall.mjs) — nhật ký truy vấn ở máy local, không lên repo
/.measure/
# Bản instrumentation đo đạc chỉ tồn tại TRONG LÚC đo rồi bị script xoá. Chặn ở đây phòng khi
# script bị Ctrl-C giữa chừng: file này bọc global.fetch, lọt lên production là hỏng đăng nhập.
/instrumentation.ts
/instrumentation-node.ts
xem-trang.html
wig-*.png
do*.png
e2e-*.png
cm-*.png
