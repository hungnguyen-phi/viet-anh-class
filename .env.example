# Sao chép file này thành .env.local rồi điền key Supabase của bạn.
# Lấy tại: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# BẮT BUỘC (server-only, KHÔNG NEXT_PUBLIC): khoá service_role — dùng cho cổng IP check-in
# cảm xúc=điểm danh (student_checkin chỉ service_role gọi được). Thiếu biến này → check-in lỗi.
# Đặt trong biến môi trường của hosting (Vercel: Project Settings > Environment Variables), KHÔNG commit.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ============================================================
# Buddy 4DX = LLM (DeepSeek qua OpenRouter). SERVER-ONLY — KHÔNG bao giờ NEXT_PUBLIC,
# đặt ở env RUNTIME của hosting (Coolify), không phải build-arg. Thiếu key → nút "Hỏi Buddy"
# báo "Buddy chưa được bật", phần còn lại của app không ảnh hưởng.
# Lấy tại: https://openrouter.ai/keys
# LƯU Ý QUYỀN RIÊNG TƯ: lib/buddy.ts CHỈ gửi số liệu đã bóc danh tính (lĩnh vực, mục tiêu,
# đã đạt, số ngày còn lại) — không tên/email/UUID. Xem docs/DATA_GOVERNANCE.md §7.
# ============================================================
# OPENROUTER_API_KEY=<openrouter-api-key>
# (Tùy chọn) Đổi model mà không phải build lại. Mặc định: deepseek/deepseek-chat
# OPENROUTER_MODEL=deepseek/deepseek-chat

# ============================================================
# Google SSO
# ============================================================
# 1) Bật nút "Đăng nhập với Google" trên trang login. Chỉ đặt = 1 SAU KHI đã làm xong
#    Bước 1-4 của docs/google-sso-setup.md (đã tạo OAuth Client thật + dán vào Supabase
#    Dashboard + bật hook chặn miền). Đặt sớm quá thì người dùng bấm vào nút chưa cấu hình
#    xong, gặp màn lỗi chung chung.
# NEXT_PUBLIC_GOOGLE_SSO_ENABLED=1

# 2) CHỈ dùng khi cấu hình bằng Supabase CLI (supabase config push).
#    Nếu bật SSO bằng Dashboard (khuyên dùng, xem docs/google-sso-setup.md) thì KHÔNG cần 2 biến dưới.
#    Lấy từ Google Cloud Console > Credentials > OAuth client ID (Web application).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-oauth-client-secret>

# ── Chạy file .sql thẳng lên database:  npm run sql -- docs/test-accounts.sql ──
# CHỈ dùng ở máy cá nhân, KHÔNG đặt biến này trên Coolify/CI — app lúc chạy không cần nó.
# Lấy: Supabase Dashboard → Project Settings → Database → Connection string → tab "URI"
#      (bấm "Display password" để thấy đầy đủ).
# ⚠ Dùng cổng 5432 (session mode). Cổng 6543 (transaction mode) KHÔNG chạy được `alter table`.
DATABASE_URL=postgresql://postgres.<ref>:<mật-khẩu>@aws-0-<vùng>.pooler.supabase.com:5432/postgres
